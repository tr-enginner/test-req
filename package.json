{
  "name": "matrix-embedded-agent",
  "version": "0.1.0",
  "description": "Multi-agent system for embedded software testing based on OpenCode",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "joern",
    "skills",
    "templates",
    "standards"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm && bun build src/direct-phase2-runner.ts --outdir dist --target node --format esm && node scripts/verify-node-runner.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:node-runner": "node scripts/test-node-runner.mjs",
    "postinstall": "bun scripts/postinstall.ts",
    "pack:offline": "bun scripts/pack-offline.ts",
    "prepare:offline-windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installer/prepare-tools-archive.windows.ps1"
  },
  "keywords": [
    "opencode",
    "plugin",
    "embedded",
    "testing",
    "multi-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.1.19",
    "@opencode-ai/sdk": "^1.1.19",
    "@repomix/tree-sitter-wasms": "0.1.17",
    "ajv": "^8.17.1",
    "jsonc-parser": "^3.3.1",
    "mammoth": "^1.11.0",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "unpdf": "^1.4.0",
    "web-tree-sitter": "0.26.8",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "1.3.6",
    "typescript": "^5.7.3"
  }
}
