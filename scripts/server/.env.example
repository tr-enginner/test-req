# Matrix Agent — Docker Compose environment variables
#
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# ── LLM Configuration (required) ────────────────────────────────────────────
# 填写宿主机或内网可访问的大模型地址（建议直接用内网 IP，例如 http://172.16.5.24:8080/v1）。
# opencode.json 中 **不会** 再写入 host.docker.internal，避免浏览器无法解析导致「Unable to connect」。
LLM_BASE_URL=http://your-llm-server:8080/v1
# 可选：写入 opencode.json 的公网/内网地址（浏览器可访问）。不设置则与 LLM_BASE_URL 相同。
# LLM_PUBLIC_URL=http://172.16.5.24:8080/v1
# 可选：仅 OpenCode **容器进程** 使用的 LLM 地址（例如 LLM 只监听宿主机 localhost 时填 host.docker.internal）
# LLM_BASE_URL_OPENCODE=http://host.docker.internal:8080/v1
#
# 浏览器访问门户的基地址（无末尾 /），用于 opencode.json 的 $schema，断网时 OpenCode Web 必须从该地址拉到 JSON Schema。
# 示例：NGINX_PORT=80 时填 http://192.168.1.10 ；若门户映射为 8080 则填 http://192.168.1.10:8080
# MATRIX_PORTAL_PUBLIC_URL=http://192.168.1.10
#
# 离线/断网部署时保持默认即可：向 OpenCode 进程注入 OPENCODE_OFFLINE 等环境变量（不写 opencode.json，避免 ConfigInvalidError）。
# 避免 OpenCode Web 启动时访问 opencode.ai、app.opencode.ai 导致界面卡住（Network 仅少量请求）。
# 需要调试外网相关行为时再设为 0。
# MATRIX_OPENCODE_OFFLINE=0
LLM_MODEL=your-model-name
LLM_API_KEY=

# ── Image version ───────────────────────────────────────────────────────────
MATRIX_VERSION=0.2.17

# ── Data directory (host path for project files) ────────────────────────────
MATRIX_DATA_DIR=/data/matrix-projects

# ── External tools directory (host path for SpecChecker, AUnit, code_slicer, Joern, Z3, etc.)
# Expected subdirectories: specchecker/, aunit/, code_slicer/, joern-cli/, z3/, vtest/
MATRIX_TOOLS_DIR=/data/matrix-tools

# ── Port mapping ────────────────────────────────────────────────────────────
NGINX_PORT=80
SAMBA_PORT=445
# Instance port range (each project gets one port for its OpenCode Web UI)
INSTANCE_PORT_RANGE=5101-5200

# ── Samba credentials ───────────────────────────────────────────────────────
# After first start, create a Samba user inside the container:
#   docker exec -it matrix-samba bash
#   groupadd matrix
#   useradd -g matrix -s /sbin/nologin <username>
#   smbpasswd -a <username>

# ── Docker Compose project name (affects network/volume naming) ─────────────
COMPOSE_PROJECT_NAME=matrix

# ── OpenCode JSON Schema (offline / air-gap) ────────────────────────────────
# 设为 1 时：写入 opencode.json 的 $schema=https://opencode.ai/config.json，由 opencode-schema-mirror 提供。
# 离线部署建议保持为 1。
MATRIX_OPENCODE_SCHEMA_MIRROR=1
# Compose 中 opencode-schema-mirror 对 opencode.ai 使用自签证书；OpenCode 仍会访问该主机（与是否写入 $schema 无关）。
# 默认跳过 TLS 校验（写入 NODE_TLS_REJECT_UNAUTHORIZED=0）。若你为 mirror 配置了正式证书，可设为 0。
MATRIX_OPENCODE_SCHEMA_INSECURE_TLS=1
# 宿主机上完整 config.json 的路径（与 docker-compose 中卷挂载一致）
OPENCODE_SCHEMA_HOST_PATH=./opencode-config/config.json
