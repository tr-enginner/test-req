;; VTest Project Configuration File
;; Generated by EnvArchitect
;;
;; Replace placeholders (ALL_CAPS_WITH_UNDERSCORES) with actual values.
;; Required sections: ProjectName, Cpu, CpuFre, Devices, Connect, PhyMem

;; ========== Project Information ==========

[ProjectName]
PROJECT_NAME_HERE

[VersionName]
1.0.0

;; ========== CPU Configuration ==========

;; CPU simulator type
;; Common values: arm_cortex_m0, arm_cortex_m3, arm_cortex_m4, arm_cortex_a9, c51
[Cpu]
CPU_TYPE_HERE

;; CPU clock frequency in Hz (e.g., 168000000 for 168MHz)
[CpuFre]
CPU_FREQ_HZ_HERE

;; CPU simulator parameters (optional)
;; CTYPE=SWIQ for SWICPU mode
;; DISABLE_COV=FALSE to enable coverage recording
;; DebuggerPort=9000 for GDB remote debugging
[SwiType]
0

;; ========== Firmware ==========

;; Compiled firmware binary (ELF, HEX, or OMF51 format)
;; MUST be absolute path. OMF51 format may have no file extension.
;; Do NOT guess or modify firmware paths — use the path from config as-is.
[BinFiles]
FIRMWARE_ABSOLUTE_PATH_HERE

;; Binary parser DLL (default: binparser.dll with param 0x0)
[BinDll]
1=binparser.dll,0x0

;; Source files for debugging and coverage analysis (optional)
;; Format: N=absolute_path (N starts from 1, continuous integers)
;; MUST be absolute paths
[SourceFiles]
;; 1=C:\project\src\main.c
;; 2=C:\project\src\hal.c

;; ========== Virtual Devices ==========

;; Device DLL list
;; Format: ID=dll_path
;; ID starts from 1, must be continuous integers
;; CPU is always ID 1000 (implicit, do not list here)
;; Path rules:
;;   - Custom/user-developed DLLs: MUST use absolute path
;;   - VTest system DLLs (from vtest\system): use DLL name only (no directory)
[Devices]
;; 1=C:\project\.matrix\test-env\sim-models\vdev_adc.dll
;; 2=C:\project\.matrix\test-env\sim-models\vdev_uart.dll
;; 3=C:\project\.matrix\test-env\sim-models\vdev_gpio.dll

;; Device display names (optional, IDs match [Devices])
[Names]
;; 1=ADC Simulator
;; 2=UART Simulator
;; 3=GPIO Simulator

;; ========== Connections ==========

;; Pin-level connections
;; Format: source_device_id.pin_name=target_device_id.pin_name
;; CPU device ID is always 1000
[Connect]
;; Example: ADC channel 0 output -> CPU ADC register
;; 1.adc_ch0=1000.ADC1_DR_CH0
;; Example: UART TX capture -> CPU USART data register
;; 2.tx_data=1000.USART1_DR

;; VPort connections (bulk data channels between devices)
;; Format: source_device_id.vport_name=target_device_id.vport_name
[VPortConnect]
;; Example: Test driver -> ADC device data input
;; 5.adc_cmd=1.adc_input

;; ========== Memory Map ==========

;; Physical memory blocks
;; Format: N=start_address,end_address,type (hexadecimal)
;; type: 0=internal RAM, 1=ROM, 2=external memory
;; NOTE: For MCS-51 (8051/8052/C51), type 0 and 1 are built into the simulator.
;;       Only add type 2 (external memory) for MCS-51 projects.
[PhyMem]
;; Flash (example: 1MB at 0x08000000)
;; 1=0x08000000,0x080FFFFF,0
;; SRAM (example: 192KB at 0x20000000)
;; 2=0x20000000,0x2002FFFF,0
;; MCS-51 external memory example:
;; 1=0x0000,0xFFFF,2

;; ========== Device Properties ==========

;; Initialization parameters passed to devices via VTT_SETPROPERTY
;; Format: device_id.property_name=value
[DeviceProperty]
;; 1.sample_rate=1000
;; 2.baudrate=115200
