{
  "name": "matrix-requirements-manager",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:api": "npm --workspace @matrix/api run dev",
    "dev:worker": "npm --workspace @matrix/worker run dev",
    "dev:web": "npm --workspace @matrix/web run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm --workspace @matrix/api run db:generate",
    "db:migrate": "npm --workspace @matrix/api run db:migrate"
  },
  "dependencies": {
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
